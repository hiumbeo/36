# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_TOKEN: Token tài khoản Discord người dùng để bot tự động đăng nhập và chạy ngay khi server Render khởi động.
# Hỗ trợ 1 token hoặc nhiều token phân tách bằng dấu phẩy: token1,token2
DISCORD_TOKEN=

# DISCORD_PREFIX: Tiền tố lệnh trong Discord (Ví dụ: !, ., ?, $)
DISCORD_PREFIX=!

# DISCORD_STATUS: Trạng thái mặc định khi tự khởi động: online, idle, dnd, invisible
DISCORD_STATUS=dnd

# DISCORD_CUSTOM_STATUS: Dòng trạng thái tuỳ chỉnh hiển thị
DISCORD_CUSTOM_STATUS=Đang leo rank Valorant 🔥

# DISCORD_CUSTOM_EMOJI: Emoji cho dòng trạng thái tuỳ chỉnh
DISCORD_CUSTOM_EMOJI=🎯

# DISCORD_ACTIVITY_NAME: Tên hoạt động Rich Presence (Ví dụ: VALORANT, Twitch, Visual Studio Code)
DISCORD_ACTIVITY_NAME=VALORANT

# DISCORD_ACTIVITY_TYPE: Loại hoạt động: 0 (Chơi game VALORANT), 1 (Stream Twitch viền tím), 2 (Nghe Spotify), 3 (Xem)
DISCORD_ACTIVITY_TYPE=0

# DISCORD_ACTIVITY_DETAILS: Chi tiết hoạt động
DISCORD_ACTIVITY_DETAILS=Competitive (Ascendant 3)

# DISCORD_ACTIVITY_STATE: Trạng thái trong trận đấu
DISCORD_ACTIVITY_STATE=In Match (Ascent - Score 11 - 9)

# DISCORD_STREAM_URL: Link stream Twitch nếu dùng loại 1 (Stream)
DISCORD_STREAM_URL=https://twitch.tv/discord_live_stream

# DISCORD_GUILD_ID: (Tuỳ chọn) ID Server Discord để bot tự động vào kênh Voice khi server bật
DISCORD_GUILD_ID=

# DISCORD_VOICE_CHANNEL_ID: (Tuỳ chọn) ID Kênh thoại (Voice Channel) để bot tự động treo 24/7
DISCORD_VOICE_CHANNEL_ID=

# DISCORD_VOICE_MUTE: Tự tắt mic (true/false, mặc định: true)
DISCORD_VOICE_MUTE=true

# DISCORD_VOICE_DEAF: Tự tắt tai nghe (true/false, mặc định: true)
DISCORD_VOICE_DEAF=true
